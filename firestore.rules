rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sticky notes on the Layali website door.
    // Visitors can read notes and add short ones, but never edit or delete.
    // Remove unwanted notes from the Firebase console.
    match /notes/{noteId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['text', 'color', 'x', 'y', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 80
        && request.resource.data.color in ['yellow', 'green', 'orange', 'pink']
        && request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 100
        && request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 100
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // "Build the Scud" weekly scoreboard: scores/{week}/entries/{id}, week like 2026-W42.
    // Scores are capped so obviously fake ones are rejected. Check the winner's
    // score on their phone at the counter before handing out a prize.
    match /scores/{week}/entries/{entryId} {
      allow read: if true;
      allow create: if week.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 16
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score <= 3000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
